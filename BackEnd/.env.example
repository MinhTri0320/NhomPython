# Sao chép thành `.env` rồi sửa cho đúng máy của bạn. KHÔNG đẩy file .env lên GitHub.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=recruitment

JWT_SECRET=doi-thanh-chuoi-bi-mat-bat-ky
JWT_EXPIRE_MINUTES=120

# Địa chỉ FrontEnd được phép gọi API (dấu phẩy ngăn cách). * = cho phép tất cả
CORS_ORIGINS=*

# Tài khoản Admin do db/setup_db.py tạo
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123

# --- Xác thực email, quên mật khẩu, refresh token (Story 15-17) ---
REFRESH_EXPIRE_DAYS=7
EMAIL_VERIFY_HOURS=24
RESET_PASSWORD_MINUTES=30
# true = chưa xác thực email thì không cho đăng nhập
REQUIRE_EMAIL_VERIFIED=false
# Địa chỉ thư mục FrontEnd/html khi chạy bằng Live Server của VS Code (dùng để tạo liên kết trong email)
FRONTEND_URL=http://127.0.0.1:5500/FrontEnd/html

# Gửi email thật qua SMTP. ĐỂ TRỐNG SMTP_HOST thì email chỉ được in ra cửa sổ BackEnd (dùng khi phát triển)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
